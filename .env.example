# Copy to .env and fill in. Never commit .env.
# Wrap values containing $ in single quotes.
ENV=qa

QA_SUPERADMIN_USERNAME=
QA_SUPERADMIN_PASSWORD=

DEMO_SUPERADMIN_USERNAME=
DEMO_SUPERADMIN_PASSWORD=

# --- AI engine (only needed for python -m ai_engine) ---
# Provider: anthropic | bedrock | bedrock-runtime
AI_PROVIDER=anthropic
# Model name, required. Use a current Claude model name from your provider.
AI_MODEL=
# Max output tokens per AI request
AI_MAX_TOKENS=32000
# For AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# For the Bedrock providers, use your normal AWS credentials and region
# AWS_REGION=
